create_clock -name sample_clk -period 10.000 [get_ports {clk}]
create_clock -name jtag_clk -period 100.000 [get_ports {tck_pad_i}]
set_clock_groups -asynchronous -group [get_clocks {sample_clk}] -group [get_clocks {jtag_clk}]
set_input_delay -clock sample_clk -max 2.000 [get_ports {a b[*] ce rst}]
set_input_delay -clock sample_clk -min 0.000 [get_ports {a b[*] ce rst}]
set_output_delay -clock sample_clk -max 2.000 [get_ports {q}]
set_output_delay -clock sample_clk -min 0.000 [get_ports {q}]
set_clock_uncertainty -hold 0.050 -from [get_clocks {sample_clk}] -to [get_clocks {sample_clk}]
set_clock_uncertainty -hold 0.050 -from [get_clocks {jtag_clk}] -to [get_clocks {jtag_clk}]
